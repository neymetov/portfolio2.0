---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import site from '../lib/site';
import type { Theme } from '../lib/theme';

interface Props {
  title: string;
  heading: string;
  page: 'about' | 'works' | 'case' | 'contacts';
  description?: string;
  image?: string;
  theme?: Theme | null;
}

const {
  title,
  heading,
  page,
  description = 'Portfolio of brand designer and Chapter Lead Elshan Neymatov',
  image = '/og-default.jpg',
  theme = null,
} = Astro.props;

// A case landing replaces the pink frame and page colours; the values live on <html> so they can cross-fade.
const themeStyle = theme
  ? `--frame-c:${theme.frame};--frame-ink:${theme.frameInk};--page-bg:${theme.bg}`
  : undefined;

// Link previews need absolute addresses.
const origin = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), origin).toString();
const imageUrl = new URL(image, origin).toString();

const tabs = [
  { id: 'works', label: 'Works', href: '/works' },
  { id: 'about', label: 'About', href: '/' },
  { id: 'contacts', label: 'Contacts', href: '/contacts' },
] as const;
const activeTab = page === 'case' ? 'works' : page;
---
<!doctype html>
<html lang="en" class:list={{ 'theme-dark': theme?.mode === 'dark' }} style={themeStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme?.frame ?? '#ff62ed'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/satoshi-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/satoshi-500.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body data-page={page} data-heading={heading}>
    <div class="frame"></div>
    <div class="topbar" transition:persist><a href="/" id="topTitle">{heading}</a></div>
    <div class="cursor" transition:persist aria-hidden="true"><span>drag</span></div>
    <div class="preview" transition:persist aria-hidden="true"><img alt="" /></div>

    <slot />

    <div class="todo-tip" id="todoTip" role="status"></div>
    <div class="lb" id="lb" hidden role="dialog" aria-label="Image viewer">
      <div class="lb-stage"></div>
      <button class="lb-btn lb-prev" aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg></button>
      <button class="lb-btn lb-next" aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></button>
      <button class="lb-btn lb-close" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      <span class="lb-count"></span>
    </div>

    <footer>
      <strong>{site.name}</strong><small>All rights reserved © <span data-year>{new Date().getFullYear()}</span></small>
    </footer>

    <nav class="pill" id="pill" aria-label="Site" transition:persist>
      <span class="ind"></span>
      {tabs.map((tab) => (
        <a href={tab.href} data-s={tab.id} data-astro-prefetch="viewport" class:list={{ on: tab.id === activeTab }} aria-current={tab.id === activeTab ? 'page' : undefined}>{tab.label}</a>
      ))}
    </nav>

    <script>
      import { gsap, reduce, runCleanups, lenis, ScrollTrigger } from '../scripts/core';
      import { mountShell, setupShell } from '../scripts/shell';

      const body = () => document.body.dataset.page;
      let shellReady = false;

      /* Safari tints its bars from this tag. After a client-side navigation it must be updated by hand,
         otherwise the bars keep the previous page's colour (pink around an orange case page). */
      const syncThemeColor = () => {
        const colour = getComputedStyle(document.documentElement).getPropertyValue('--frame-c').trim() || '#ff62ed';
        const tags = document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]');
        const fresh = Object.assign(document.createElement('meta'), { name: 'theme-color', content: colour });
        document.head.appendChild(fresh);
        tags.forEach((old) => old.remove());
      };
      document.addEventListener('astro:after-swap', syncThemeColor);
      syncThemeColor();

      /* the outgoing page blurs away first, then the new one is fetched and swapped in */
      document.addEventListener('astro:before-preparation', (event) => {
        const load = event.loader;
        event.loader = async () => {
          const main = document.querySelector('main');
          if (main && !reduce) {
            await gsap.to(main, { opacity: 0, y: -12, filter: 'blur(12px)', duration: 0.34, ease: 'power2.in' });
          }
          await load();

          /* WebKit (Safari and every browser on iOS) keeps tinting its bars with the colour of the first page it loaded.
             When the next page has a different colour, load it with a normal navigation, which always updates the bars. */
          const ua = navigator.userAgent;
          const webkit = /iP(hone|ad|od)/.test(ua) || (/Safari/.test(ua) && !/Chrome|Chromium|Android/.test(ua));
          const next = event.newDocument?.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.content;
          const current = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.content;
          if (webkit && next && current && next.toLowerCase() !== current.toLowerCase()) {
            location.assign(event.to.href);
            await new Promise(() => {}); // the browser is leaving this page: never continue with the swap
          }
        };
      });

      document.addEventListener('astro:before-swap', () => {
        runCleanups();
        ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
        lenis?.start();
      });

      /* keep the new page invisible until its entrance animation has set its start state */
      document.addEventListener('astro:after-swap', () => {
        const main = document.querySelector<HTMLElement>('main');
        if (main && !reduce) main.style.visibility = 'hidden';
        if (lenis) lenis.scrollTo(0, { immediate: true });
        else scrollTo(0, 0);
      });

      document.addEventListener('astro:page-load', async () => {
        if (!shellReady) {
          setupShell();
          shellReady = true;
        }
        const main = document.querySelector<HTMLElement>('main');
        try {
          mountShell();
          const page = body();
          if (page === 'about') (await import('../scripts/about')).init();
          else if (page === 'works') (await import('../scripts/works')).init();
          else if (page === 'case') (await import('../scripts/case')).init();
          else if (page === 'contacts') (await import('../scripts/contacts')).init();
        } finally {
          if (main) main.style.visibility = '';
          ScrollTrigger.refresh();
        }
      });
    </script>
  </body>
</html>

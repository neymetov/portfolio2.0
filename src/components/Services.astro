---
import { categories, projects } from '../lib/projects';

interface Props { class?: string }
const { class: className } = Astro.props;

/* The rows are the works categories themselves, so they always match the filter on /works.
   The hover picture is the cover of the first project in that category. */
const rows = categories.map((category) => ({
  title: category,
  category,
  image: projects.find((project) => project.category === category && project.cover)?.cover,
}));
---
<nav class:list={['services', className]} aria-label="Services">
  {rows.map((service) => (
    <a href={`/works?category=${encodeURIComponent(service.category)}`} data-filter={service.category} data-img={service.image}>
      <span class="nm">{service.title}</span>
      <span class="arr"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
    </a>
  ))}
</nav>

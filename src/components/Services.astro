---
import site from '../lib/site';

interface Props { class?: string }
const { class: className } = Astro.props;
---
<nav class:list={['services', className]} aria-label="Services">
  {site.services.map((service) => (
    <a href={`/works?category=${encodeURIComponent(service.category)}`} data-filter={service.category} data-img={service.image || undefined}>
      <span class="nm">{service.title}</span>
      <span class="arr"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
    </a>
  ))}
</nav>

---
import type { Block } from '../lib/projects';

interface Props { blocks: Block[] }
const { blocks } = Astro.props;
const back = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>';
// Images are never draggable or clickable on a landing, so they cannot be dragged out or opened in a viewer.
const still = { draggable: 'false' } as const;
---
{blocks.map((block) => {
  if (block.discriminant === 'hero') {
    const b = block.value;
    if (!b.title) return null;
    return (
      <section class="lb-hero">
        <div class="lb-hero-media">
          {b.video ? <video src={b.video} poster={b.poster || undefined} autoplay muted loop playsinline disablepictureinpicture controlslist="nodownload noremoteplayback"></video> : b.poster ? <img src={b.poster} alt="" {...still} /> : null}
        </div>
        <div class="lb-hero-text"><h1>{b.title}</h1>{b.showSub !== false && b.sub && <p>{b.sub}</p>}</div>
        <a class="cs-back lb-back" href="/works"><Fragment set:html={back} />All works</a>
      </section>
    );
  }
  if (block.discriminant === 'intro') {
    const b = block.value;
    if (!b.text) return null;
    return (
      <section class="lb-intro lb-pad">
        <p class="lb-statement">{b.text}</p>
        <dl class="lb-meta">{b.meta.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}</dl>
      </section>
    );
  }
  if (block.discriminant === 'zoom') {
    const b = block.value;
    if (!b.image) return null;
    return (
      <section class="lb-zoom">
        <figure class="lb-zoom-fig"><img src={b.image} alt={b.alt} {...still} /></figure>
      </section>
    );
  }
  if (block.discriminant === 'pinned') {
    const b = block.value;
    if (!b.steps.length) return null;
    return (
      <section class="lb-pinned lb-pad">
        <h2 class="lb-h2">{b.title}</h2>
        <div class="lb-pin-grid">
          <div class="lb-pin-col">
            <div class="lb-pin-img">
              {b.steps.map((step, i) => <img src={step.image} alt="" class={i ? '' : 'on'} {...still} />)}
              <div class="lb-progress">{b.steps.map(() => <i></i>)}</div>
            </div>
          </div>
          <ol class="lb-steps">
            {b.steps.map((step, i) => (
              <li class:list={['lb-step', { on: i === 0 }]}>
                <h3>{step.heading}</h3><p>{step.text}</p>
                <img class="lb-step-img" src={step.image} alt="" loading="lazy" {...still} />
              </li>
            ))}
          </ol>
        </div>
      </section>
    );
  }
  if (block.discriminant === 'fan') {
    const b = block.value;
    if (!b.images.length) return null;
    return (
      <section class="lb-stories">
        {b.title && <h2 class="lb-h2 lb-pad-x">{b.title}</h2>}
        <div class="lb-fan">
          {b.images.map((src, i) => (
            <figure class="lb-story" style={`--i:${i};--n:${b.images.length}`}><img src={src} alt="" loading="lazy" {...still} /></figure>
          ))}
        </div>
      </section>
    );
  }
  if (block.discriminant === 'wide') {
    const b = block.value;
    if (!b.image && !b.video) return null;
    return (
      <section class="lb-wide lb-pad">
        <figure class="lb-wide-fig">
          {b.video ? <video src={b.video} poster={b.image || undefined} autoplay muted loop playsinline preload="metadata" disablepictureinpicture controlslist="nodownload noremoteplayback"></video> : <img src={b.image} alt={b.alt} loading="lazy" {...still} />}
        </figure>
        {b.caption && <figcaption class="lb-cap">{b.caption}</figcaption>}
      </section>
    );
  }
  if (block.discriminant === 'reels') {
    const b = block.value;
    const videos = b.videos.filter((item) => item.video);
    if (!videos.length) return null;
    return (
      <section class="lb-reels lb-pad">
        {b.title && <h2 class="lb-h2">{b.title}</h2>}
        <div class="lb-reels-row" style={`--n:${videos.length}`}>
          {videos.map((item) => (
            <figure class="lb-reel"><video src={item.video} poster={item.poster || undefined} autoplay muted loop playsinline preload="metadata" disablepictureinpicture controlslist="nodownload noremoteplayback"></video></figure>
          ))}
        </div>
      </section>
    );
  }
  if (block.discriminant === 'gallery') {
    const b = block.value;
    if (b.images.length < 1) return null;
    return (
      <section class="lb-gallery lb-pad">
        <div class="lb-gallery-grid">
          {b.images.map((item) => <figure><img src={item.image} alt={item.alt} loading="lazy" {...still} /></figure>)}
        </div>
      </section>
    );
  }
  return null;
})}

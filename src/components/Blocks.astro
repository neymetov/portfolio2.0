---
import type { Block } from '../lib/projects';

interface Props { blocks: Block[] }
const { blocks } = Astro.props;
const back = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>';
---
{blocks.map((block) => {
  if (block.discriminant === 'hero') {
    const b = block.value;
    return (
      <section class="lb-hero">
        <div class="lb-hero-media">
          {b.video ? <video src={b.video} poster={b.poster || undefined} autoplay muted loop playsinline></video> : b.poster ? <img src={b.poster} alt="" /> : null}
        </div>
        <div class="lb-hero-text"><span class="lb-kicker">{b.kicker}</span><h1>{b.title}</h1><p>{b.sub}</p></div>
        <a class="cs-back lb-back" href="/works"><Fragment set:html={back} />All works</a>
      </section>
    );
  }
  if (block.discriminant === 'intro') {
    const b = block.value;
    return (
      <section class="lb-intro lb-pad">
        <p class="lb-statement">{b.text}</p>
        <dl class="lb-meta">{b.meta.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}</dl>
      </section>
    );
  }
  if (block.discriminant === 'zoom') {
    const b = block.value;
    return (
      <section class="lb-zoom">
        <figure class="lb-zoom-fig"><img src={b.image} alt={b.alt} /></figure>
        {b.caption && <figcaption class="lb-cap">{b.caption}</figcaption>}
      </section>
    );
  }
  if (block.discriminant === 'palette') {
    const b = block.value;
    const [caps1 = '', caps2 = '', script = '', caps3 = ''] = b.specimen;
    return (
      <section class="lb-palette lb-pad">
        <h2 class="lb-h2">{b.title}</h2>
        <div class="lb-swatches">
          {b.colors.map((colour) => (
            <button class="lb-sw" style={`--c:${colour.hex}`} data-hex={colour.hex} aria-label={`${colour.name}, ${colour.hex}. Copy hex`}>
              <span class="lb-sw-chip"></span><b>{colour.name}</b><span class="lb-hex">{colour.hex}</span>
            </button>
          ))}
        </div>
        <div class="lb-specimen"><span class="sp-caps">{caps1}</span><span class="sp-caps">{caps2}</span><span class="sp-script">{script}</span><span class="sp-caps">{caps3}</span></div>
      </section>
    );
  }
  if (block.discriminant === 'pinned') {
    const b = block.value;
    return (
      <section class="lb-pinned lb-pad">
        <h2 class="lb-h2">{b.title}</h2>
        <div class="lb-pin-grid">
          <div class="lb-phone-col">
            <div class="lb-phone">
              {b.steps.map((step, i) => <img src={step.image} alt="" class={i ? '' : 'on'} />)}
              <div class="lb-progress">{b.steps.map(() => <i></i>)}</div>
            </div>
          </div>
          <ol class="lb-steps">
            {b.steps.map((step, i) => (
              <li class:list={['lb-step', { on: i === 0 }]}>
                <span class="lb-num">0{i + 1}</span><h3>{step.heading}</h3><p>{step.text}</p>
                <img class="lb-step-img" src={step.image} alt="" loading="lazy" />
              </li>
            ))}
          </ol>
        </div>
      </section>
    );
  }
  if (block.discriminant === 'stories') {
    const b = block.value;
    return (
      <section class="lb-stories">
        <h2 class="lb-h2 lb-pad-x">{b.title}</h2>
        <div class="lb-fan">
          {b.images.map((src, i) => (
            <figure class="lb-story" style={`--i:${i};--n:${b.images.length}`}><img src={src} alt={`Story ${i + 1}`} loading="lazy" /></figure>
          ))}
        </div>
      </section>
    );
  }
  if (block.discriminant === 'wide') {
    const b = block.value;
    return (
      <section class="lb-wide lb-pad">
        <figure class="lb-wide-fig"><img src={b.image} alt={b.alt} loading="lazy" /></figure>
        {b.caption && <figcaption class="lb-cap">{b.caption}</figcaption>}
      </section>
    );
  }
  return null;
})}

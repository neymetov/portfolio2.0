---
import BaseLayout from '../layouts/BaseLayout.astro';
import Services from '../components/Services.astro';
import site from '../lib/site';
import { featuredProjects } from '../lib/projects';
import { yearsSince } from '../lib/years';

export const prerender = true;

const art = '/images/site';
// The strip scrolls forever, so one pass must be wider than any screen: repeat the list until it holds at least 8 cards.
const careerStart = site.careerStart || '2013-09-01';
const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const stories = site.stories.map((story) => ({ title: story.title, text: story.text, art: story.art }));
const tiltOf = [0, 0, 10, 0, -10];
const fan = [
  { ft: -14, fx: -190, fy: -40 },
  { ft: -6, fx: -95, fy: 30 },
  { ft: -10, fx: 0, fy: -50 },
  { ft: 6, fx: 95, fy: 30 },
  { ft: 24, fx: 190, fy: -40 },
];
---
<BaseLayout title={`${site.name} — brand designer and Chapter Lead`} heading={site.name} page="about" description={`${site.heroLead} ${site.heroAccent}`}>
  <main id="view-about" class="view">
    <section class="hero" id="about">
      <canvas id="ring" data-stories={JSON.stringify(stories)} aria-label="Story cards on a rotating ring. Swipe to turn, tap a card to read it"></canvas>
      <div class="ring-fallback" hidden>
        {stories.map((story) => (
          <article class="ring-card">
            <img src={`${art}/art-${story.art}.png`} alt="" width="120" height="120" loading="lazy" />
            <h3>{story.title}</h3>
            <p>{story.text}</p>
          </article>
        ))}
      </div>
      <div class="hero-text">
        <img class="avatar" src={`${art}/avatar.webp`} alt={site.name} width="80" height="80" />
        <div class="badge"><b data-career-start={careerStart}>{yearsSince(careerStart)}</b>years of experience</div>
        <h1 class="split">{site.heroLead} <span class="pink">{site.heroAccent}</span></h1>
        <a class="cv-btn" id="cvBtn" href={site.cv || '#cv'} data-file={site.cv} {...(site.cv ? { target: '_blank', rel: 'noopener' } : {})}>
          Download CV
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>
          <span class="cv-tip">CV file coming soon</span>
        </a>
      </div>
    </section>

    <section class="experience" id="exp" aria-label="Experience">
      <div class="exp-scroll" style={`--n:${site.experience.length}`}>
        <div class="exp-stage">
          <h2 class="display">experience</h2>
          <div class="exp-body">
            <div class="track" id="track" data-exp={JSON.stringify(site.experience)}>
              <div class="fill" id="fill"></div>
              {site.experience.map((job, index) => <button class="yr" data-i={index} aria-label={`${job.company}, ${job.year}`}>{job.year}</button>)}
              <div class="logo-tile" id="tile"><img id="tileImg" src={site.experience[0]?.photo} alt="" /></div>
            </div>
            <div class="exp-copy" id="copy" aria-live="polite">
              <div class="in"><h3>{site.experience[0]?.company}</h3><strong>{site.experience[0]?.role}</strong><p>{site.experience[0]?.text}</p></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="meetups" id="meetups">
      <div>
        <h2 class="display split"><span class="nowrap">meetups <em>&amp;</em></span><br /> workshops</h2>
        <p>{site.meetupText}</p>
      </div>
      <div class="collage" aria-label="Meetups and workshops photos">
        {site.meetupPhotos.slice(0, 5).map((photo, index) => (
          <img src={photo} alt="" width="280" height="280" loading="lazy" style={`--tilt:${tiltOf[index]}deg;--ft:${fan[index].ft}deg;--fx:${fan[index].fx}px;--fy:${fan[index].fy}px`} />
        ))}
      </div>
    </section>

    <section class="featured" id="works">
      <h2 class="display split">some <em>big</em> projects</h2>
      <div class="items">
        {featuredProjects.map((project, index) => (
          <article class="f-item">
            <div class:list={['stack', { mirror: index === 0 }]}>
              <div class="slide back"><div class="face">{project.gallery[1]?.image && <img src={project.gallery[1].image} alt="" loading="lazy" />}<div class="glare"></div></div></div>
              <div class="slide front"><div class="face">{project.cover && <img src={project.cover} alt={project.title} loading="lazy" />}<div class="glare"></div></div></div>
            </div>
            <div class="f-info">
              <h3>{project.title}</h3>
              <a class="text-link" href={`/works/${project.slug}`}>Read the case <Fragment set:html={arrow} /></a>
            </div>
          </article>
        ))}
      </div>
      <a class="pill-btn" href="/works">see all projects</a>
    </section>

    <Services />

    {site.showCta && (
      <section class="cta" id="cta">
        <div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div>
        <div>
          <h2 class="split">{site.ctaTitle}</h2>
          <a class="btn" href="/contacts">Text me →</a>
        </div>
      </section>
    )}
  </main>

  <div class="story-sheet" id="storySheet" hidden role="dialog" aria-label="Story card">
    <div class="ss-card"><canvas></canvas></div>
    <div class="ss-nav">
      <button class="lb-btn ss-prev" aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg></button>
      <span class="ss-count">1 / 4</span>
      <button class="lb-btn ss-next" aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></button>
    </div>
    <button class="lb-btn ss-close" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { placeholderImage, projects } from '../../lib/projects';

export const prerender = true;

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const images = project.gallery.length ? project.gallery : Array<string>(4).fill(placeholderImage);
---
<BaseLayout title={`${project.title} — Elshan Neymatov`} description={project.summary || project.description} active="works">
  <PageHeader title={project.title} />
  <article class="sheet case">
    <header class="case-intro">
      <h1>{project.subtitle || project.title}</h1>
      <p>{project.description}</p>
    </header>
    <section class="case-gallery" aria-label="Project images">
      {images.map((image, index) => (
        <>
          <div class="case-image">
            <img src={image} alt={`${project.title}, image ${index + 1}`} loading={index < 2 ? 'eager' : 'lazy'} width="343" height="343" />
          </div>
          {index === 1 && project.galleryNote && <p class="case-note">{project.galleryNote}</p>}
        </>
      ))}
    </section>
  </article>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Blocks from '../../components/Blocks.astro';
import { nextProject, projects } from '../../lib/projects';
import { resolveTheme } from '../../lib/theme';

export const prerender = true;

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const next = nextProject(project.slug);
const landing = project.landing.discriminant ? project.landing.value : null;
const theme = landing ? resolveTheme(landing.theme) : null;
const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const back = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>';
const style = theme ? `--t-bg:${theme.bg};--t-surface:${theme.surface};--t-text:${theme.text};--t-muted:${theme.muted};--t-accent:${theme.accent}` : undefined;
---
<BaseLayout title={`${project.title} — Elshan Neymatov`} heading={project.title} page="case" theme={theme} description={project.summary || undefined}>
  <main id="view-case" class:list={['view', 'case-view', { landing }]} style={style} data-slug={project.slug}>
    {landing ? (
      <Blocks blocks={landing.blocks} />
    ) : (
      <>
        <a class="cs-back" href="/works"><Fragment set:html={back} />All works</a>
        <header class="cs-intro">
          <span class="cs-cat">{project.category}</span>
          <h1 class="display">{project.title}</h1>
          <p>{project.description}</p>
        </header>
        <section class="cs-gallery">
          {(project.gallery.length ? project.gallery : [{}, {}, {}, {}]).map((item: any, index) => (
            <figure class:list={['cs-tile', { wide: item.wide }]} data-k={index}>
              <div class="cs-media">
                {item.video ? (
                  <video src={item.video} poster={item.image || undefined} autoplay muted loop playsinline preload="metadata"></video>
                ) : item.image ? (
                  <img src={item.image} alt={item.alt || project.title} loading="lazy" />
                ) : null}
                <div class="glare"></div>
              </div>
            </figure>
          ))}
        </section>
      </>
    )}
    <a class:list={['cs-next', { 'lb-pad-x': landing }]} href={`/works/${next.slug}`}>
      <span class="cs-next-label">Next project</span>
      <span class="cs-next-title">{next.title}</span>
      <span class="arr"><Fragment set:html={arrow} /></span>
    </a>
  </main>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Services from '../../components/Services.astro';
import { categories, projects } from '../../lib/projects';

export const prerender = true;

const tabs = ['All', ...categories];
---
<BaseLayout title="Works — Elshan Neymatov" heading="Works" page="works" description="Selected branding, packaging and illustration projects by Elshan Neymatov.">
  <main id="view-works" class="view works-view">
    <h1 class="sr-only w-title">Selected works</h1>
    <div class="w-filter-wrap">
      <div class="w-filter" role="group" aria-label="Project category">
        <span class="w-ind"></span>
        {tabs.map((category, index) => (
          <button type="button" class:list={{ on: index === 0 }} data-filter={category} aria-pressed={index === 0 ? 'true' : 'false'}>{category}</button>
        ))}
      </div>
    </div>
    <section class="w-list" aria-live="polite">
      {projects.map((project) => (
        <a class="w-card" href={`/works/${project.slug}`} data-category={project.category}>
          <div class="w-img">
            {project.coverVideo ? (
              <video src={project.coverVideo} poster={project.cover || undefined} autoplay muted loop playsinline preload="metadata"></video>
            ) : project.cover ? (
              <img src={project.cover} alt="" loading="lazy" />
            ) : null}
            <div class="glare"></div>
          </div>
          <div class="w-body"><h2>{project.title}</h2><p>{project.summary}</p></div>
        </a>
      ))}
      <p class="w-empty" hidden>Nothing here yet</p>
    </section>
    <Services class="w-services" />
  </main>
</BaseLayout>

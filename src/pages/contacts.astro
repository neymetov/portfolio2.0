---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import site from '../content/site.json';

export const prerender = true;
---
<BaseLayout title="Contacts — Elshan Neymatov" active="contacts" footer={false} dark>
  <PageHeader title="Contacts" />
  <section class="sheet sheet--dark contact-panel">
    <h1>{site.contactTitle}</h1>
    <form id="contact-form" data-email={site.contactEmail}>
      <label class="sr-only" for="message">Your message</label>
      <textarea id="message" name="message" placeholder={site.contactPrompt} required></textarea>
      <button type="submit" class="pill pill--pink">Send</button>
    </form>
    <strong class="contact-or">or</strong>
    <a class="contact-email" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
  </section>
</BaseLayout>

<script>
  // Runs on first load and after every client-side navigation.
  const init = () => {
    const form = document.querySelector<HTMLFormElement>('#contact-form');
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const message = String(new FormData(form).get('message') ?? '').trim();
      if (!message) return;
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Message from the portfolio')}&body=${encodeURIComponent(message)}`;
    });
  };
  document.addEventListener('astro:page-load', init);
</script>

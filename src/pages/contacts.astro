---
import BaseLayout from '../layouts/BaseLayout.astro';
import site, { telegramUrl, whatsappUrl } from '../lib/site';

export const prerender = true;

const wa = whatsappUrl(site.whatsapp);
const tg = telegramUrl(site.telegram);
const chats = [
  { id: 'wa', name: 'WhatsApp', url: wa, todo: 'WhatsApp number', chat: site.whatsappChat },
  { id: 'tg', name: 'Telegram', url: tg, todo: 'Telegram username', chat: site.telegramChat },
];
---
<BaseLayout title="Contacts — Elshan Neymatov" heading="Contacts" page="contacts">
  <main id="view-contacts" class="view contacts-view">
    <section class="c-head">
      <h1 class="display">{site.contactTitle} <em>{site.contactAccent}</em></h1>
      <p>{site.contactText}</p>
    </section>

    <section class="c-cards">
      {chats.map(({ id, name, url, todo, chat }) => (
        <a class={`c-card ${id}`} href={url || undefined} data-todo={url ? undefined : todo} target={url ? '_blank' : undefined} rel={url ? 'noopener' : undefined} aria-label={`Write on ${name}`}>
          <div class="c-face">
            <div class="c-ui">
              <div class="c-chat-head"><img src="/images/site/avatar.webp" alt="" width="32" height="32" /><div><b>{site.name}</b><small>Brand designer</small></div></div>
              <div class="c-bubble out">{chat.outgoing}<span>{chat.outgoingTime}</span></div>
              <div class="c-bubble in">{chat.incoming}<span>{chat.incomingTime}</span></div>
              <div class="c-compose">
                <span>Message</span>
                <i>
                  {id === 'wa' ? (
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
                  ) : (
                    <svg viewBox="0 0 24 24" fill="#fff"><path d="M3 11.5l17-7.5-3 16-5.5-4.5-3 3v-4.5l8-7.5-10 6z"/></svg>
                  )}
                </i>
              </div>
            </div>
            <span class="c-btn">Open {name}</span>
            <div class="glare"></div>
          </div>
        </a>
      ))}
    </section>

    <nav class="c-social" aria-label="Social networks">
      {site.socials.map((social) => (
        <a href={social.url || undefined} data-todo={social.url ? undefined : `${social.label} URL`} target={social.url ? '_blank' : undefined} rel={social.url ? 'noopener' : undefined}>
          <span class="nm">{social.label}</span>
          <span class="arr"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M7 17L17 7M8 7h9v9"/></svg></span>
        </a>
      ))}
    </nav>
  </main>
</BaseLayout>
